    if count < MAX_GENERATORS {
        draw_int(count, 92, y + 6, WHITE);
        draw_text_id(47, 136, y + 6, GRAY);
        draw_int(cps, 92, y + 22, GREEN);
        draw_text_id(39, 136, y + 22, GRAY);
        draw_int(cost, 218, y + 6, YELLOW);
