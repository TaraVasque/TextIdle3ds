fn clamp_seed_group(value: int) -> int {
    if value < 0 {
        return 0;
    }

    if value > MAX_SEED_GROUP {
        return MAX_SEED_GROUP;
    }

    return value;
}

fn add_coins(amount: int) {
    if amount <= 0 {
        return;
    }

    if amount > MAX_INT - coins {
        coins = MAX_INT;
    } else {
        coins = coins + amount;
    }

    if amount > MAX_INT - lifetime_coins {
        lifetime_coins = MAX_INT;
    } else {
        lifetime_coins = lifetime_coins + amount;
    }

    if coins > highest_coins {
        highest_coins = coins;
    }
}

fn update_generator_costs() {
    if cursors < MAX_GENERATORS {
        cursor_cost = 15 + (cursors * 15);
    }

    if workers < MAX_GENERATORS {
        worker_cost = 100 + (workers * 100);
    }

    if factories < MAX_GENERATORS {
        factory_cost = 750 + (factories * 750);
    }

    if cores < MAX_GENERATORS {
        core_cost = 5000 + (cores * 5000);
    }
}

fn get_production() -> int {
    let production = 0;

    production = production + cursors;
    production = production + (workers * 8);
    production = production + (factories * 60);
    production = production + (cores * 500);

    if upgrade_production {
        production = production * 2;
    }

    return production;
}

fn cursor_upgrade_cost() -> int {
    return 1000 + (cursor_click_upgrades * 1000);
}

fn worker_upgrade_cost() -> int {
    return 1000 + (worker_click_upgrades * 1000);
}

fn factory_upgrade_cost() -> int {
    return 1000 + (factory_click_upgrades * 1000);
}

fn core_upgrade_cost() -> int {
    return 1000 + (core_click_upgrades * 1000);
}

fn show_message(code: int) {
    message_code = code;
    message_timer = millis() + 1500;
}

// -----------------------------------------------------------------------------
// reset button. big red cosmic oopsie button.
// -----------------------------------------------------------------------------
fn reset_game() {
    coins = 0;
    lifetime_coins = 0;
    clicks = 0;
    critical_clicks = 0;
    click_power = 1;
    click_multiplier = 1;
    combo = 0;
    best_combo = 0;
    highest_coins = 0;

    cursors = 0;
    workers = 0;
    factories = 0;
    cores = 0;

    cursor_click_upgrades = 0;
    worker_click_upgrades = 0;
    factory_click_upgrades = 0;
    core_click_upgrades = 0;

    upgrade_click = false;
    upgrade_production = false;
    upgrade_critical = false;

    update_generator_costs();

    combo_timer = 0;
    last_second = millis();
}

// -----------------------------------------------------------------------------
// click click click. behold, the economy.
// -----------------------------------------------------------------------------
fn do_click() {
    let reward = click_power * click_multiplier;

    clicks = clicks + 1;
    combo = combo + 1;
    combo_timer = millis() + 1800;

    if combo > best_combo {
        best_combo = combo;
    }

    // every ten clicks the dice wake up and go "hmmmm"
    if upgrade_critical {
        if clicks % 10 == 0 {
            if rand(4) == 0 {
                reward = reward * 5;
                critical_clicks = critical_clicks + 1;
            }
        }
    }

    // combo gets spicy after ten. apparently clicking repeatedly has consequences.
    if combo >= 10 {
        reward = reward + ((combo / 10) * click_power);
    }

    add_coins(reward);
    show_message(1);
}

// -----------------------------------------------------------------------------
// buy machines until they literally cannot buy any more. then click harder.
// -----------------------------------------------------------------------------
fn buy_cursor() {
    if cursors < MAX_GENERATORS {
        if coins >= cursor_cost {
            coins = coins - cursor_cost;
            cursors = cursors + 1;
            update_generator_costs();
            show_message(2);
        }
    } else {
        let cost = cursor_upgrade_cost();

        if coins >= cost {
            coins = coins - cost;
            cursor_click_upgrades = cursor_click_upgrades + 1;
            click_power = click_power + 1;
            show_message(8);
        }
    }
}

fn buy_worker() {
    if workers < MAX_GENERATORS {
        if coins >= worker_cost {
            coins = coins - worker_cost;
            workers = workers + 1;
            update_generator_costs();
            show_message(2);
        }
    } else {
        let cost = worker_upgrade_cost();

        if coins >= cost {
            coins = coins - cost;
            worker_click_upgrades = worker_click_upgrades + 1;
            click_power = click_power + 5;
            show_message(8);
        }
    }
}

fn buy_factory() {
    if factories < MAX_GENERATORS {
        if coins >= factory_cost {
            coins = coins - factory_cost;
            factories = factories + 1;
            update_generator_costs();
            show_message(2);
        }
    } else {
        let cost = factory_upgrade_cost();

        if coins >= cost {
            coins = coins - cost;
            factory_click_upgrades = factory_click_upgrades + 1;
            click_power = click_power + 25;
            show_message(8);
        }
    }
}

fn buy_core() {
    if cores < MAX_GENERATORS {
        if coins >= core_cost {
            coins = coins - core_cost;
            cores = cores + 1;
            update_generator_costs();
            show_message(2);
        }
    } else {
        let cost = core_upgrade_cost();

        if coins >= cost {
            coins = coins - cost;
            core_click_upgrades = core_click_upgrades + 1;
            click_power = click_power + 100;
            show_message(8);
        }
    }
}

// -----------------------------------------------------------------------------
// normal upgrades. suspiciously normal.
// -----------------------------------------------------------------------------
fn buy_click_upgrade() {
    if !upgrade_click {
        if coins >= 500 {
            coins = coins - 500;
            upgrade_click = true;
            click_power = click_power + 4;
            show_message(3);
        }
    }
}

fn buy_production_upgrade() {
    if !upgrade_production {
        if coins >= 2500 {
            coins = coins - 2500;
            upgrade_production = true;
            show_message(3);
        }
    }
}

fn buy_critical_upgrade() {
    if !upgrade_critical {
        if coins >= 7500 {
            coins = coins - 7500;
            upgrade_critical = true;
            click_multiplier = 2;
            show_message(3);
        }
    }
}

// -----------------------------------------------------------------------------
// the save code. one complete, human-readable string.
//
// Format:
// C<coins>-Cur<bytes>-W<workers>-F<factories>-Co<cores>-P<click power>
// -Crit<critical upgrade>-Cnt<clicks>-CC<critical clicks>-Lif<lifetime>
// -Hi<highest>-CU<cursor upgrades>-WU<worker upgrades>
// -FU<factory upgrades>-CoU<core upgrades>-PU<production upgrade>
// -----------------------------------------------------------------------------
fn save_code_digit_count(value: int) -> int {
    if value == 0 {
        return 1;
    }

    let count = 0;
    let work = value;

    if work < 0 {
        work = 0 - work;
    }

    while work > 0 {
        count = count + 1;
        work = work / 10;
    }

    return count;
}

fn save_code_add_char(value: int) {
    if save_input_length < 255 {
        save_input[save_input_length] = value;
        save_input_length = save_input_length + 1;
    }
}

fn save_code_add_text_c() {
    save_code_add_char(67);
}

fn save_code_add_text_cur() {
    save_code_add_char(67);
    save_code_add_char(117);
    save_code_add_char(114);
}

fn save_code_add_text_w() {
    save_code_add_char(87);
}

fn save_code_add_text_f() {
    save_code_add_char(70);
}

fn save_code_add_text_co() {
    save_code_add_char(67);
    save_code_add_char(111);
}

fn save_code_add_text_p() {
    save_code_add_char(80);
}

fn save_code_add_text_crit() {
    save_code_add_char(67);
    save_code_add_char(114);
    save_code_add_char(105);
    save_code_add_char(116);
}

fn save_code_add_text_cnt() {
    save_code_add_char(67);
    save_code_add_char(110);
    save_code_add_char(116);
}

fn save_code_add_text_cc() {
    save_code_add_char(67);
    save_code_add_char(67);
}

fn save_code_add_text_lif() {
    save_code_add_char(76);
    save_code_add_char(105);
    save_code_add_char(102);
}

fn save_code_add_text_hi() {
    save_code_add_char(72);
    save_code_add_char(105);
}

fn save_code_add_text_cu() {
    save_code_add_char(67);
    save_code_add_char(85);
}

fn save_code_add_text_wu() {
    save_code_add_char(87);
    save_code_add_char(85);
}

fn save_code_add_text_fu() {
    save_code_add_char(70);
    save_code_add_char(85);
}

fn save_code_add_text_cou() {
    save_code_add_char(67);
    save_code_add_char(111);
    save_code_add_char(85);
}

fn save_code_add_text_pu() {
    save_code_add_char(80);
    save_code_add_char(85);
}

fn save_code_add_number(value: int) {
    let divisor = 1;
    let digits = save_code_digit_count(value);
    let i = 1;

    while i < digits {
        divisor = divisor * 10;
        i = i + 1;
    }

    if value == 0 {
        save_code_add_char(48);
        return;
    }

    while divisor > 0 {
        let digit = (value / divisor) % 10;
        save_code_add_char(48 + digit);
        divisor = divisor / 10;
    }
}

fn save_code_build() {
    save_input_length = 0;

    save_code_add_text_c();
    save_code_add_number(coins);
    save_code_add_text_cur();
    save_code_add_number(cursors);
    save_code_add_text_w();
    save_code_add_number(workers);
    save_code_add_text_f();
    save_code_add_number(factories);
    save_code_add_text_co();
    save_code_add_number(cores);
    save_code_add_text_p();
    save_code_add_number(click_power);
    save_code_add_text_crit();
    if upgrade_critical {
        save_code_add_number(1);
    } else {
        save_code_add_number(0);
    }
    save_code_add_text_cnt();
    save_code_add_number(clicks);
    save_code_add_text_cc();
    save_code_add_number(critical_clicks);
    save_code_add_text_lif();
    save_code_add_number(lifetime_coins);
    save_code_add_text_hi();
    save_code_add_number(highest_coins);
    save_code_add_text_cu();
    save_code_add_number(cursor_click_upgrades);
    save_code_add_text_wu();
    save_code_add_number(worker_click_upgrades);
    save_code_add_text_fu();
    save_code_add_number(factory_click_upgrades);
    save_code_add_text_cou();
    save_code_add_number(core_click_upgrades);
    save_code_add_text_pu();
    if upgrade_production {
        save_code_add_number(1);
    } else {
        save_code_add_number(0);
    }
}

fn save_code_expect(value: int) {
    if !save_parse_ok {
        return;
    }

    if save_parse_pos >= save_input_length {
        save_parse_ok = false;
        return;
    }

    if save_input[save_parse_pos] != value {
        save_parse_ok = false;
        return;
    }

    save_parse_pos = save_parse_pos + 1;
}

fn save_code_read_number() -> int {
    let value = 0;
    let found_digit = false;

    if !save_parse_ok {
        return 0;
    }

    while save_parse_pos < save_input_length {
        let ch = save_input[save_parse_pos];

        if ch >= 48 && ch <= 57 {
            let digit = ch - 48;

            if value > (MAX_INT - digit) / 10 {
                save_parse_ok = false;
                return 0;
            }

            value = (value * 10) + digit;
            found_digit = true;
            save_parse_pos = save_parse_pos + 1;
        } else {
            break;
        }
    }

    if !found_digit {
        save_parse_ok = false;
    }

    return value;
}

fn save_code_parse() {
    save_parse_pos = 0;
    save_parse_ok = true;

    // C
    save_code_expect(67);
    save_values[0] = save_code_read_number();

    // Cur
    save_code_expect(67);
    save_code_expect(117);
    save_code_expect(114);
    save_values[1] = save_code_read_number();

    // W
    save_code_expect(87);
    save_values[2] = save_code_read_number();

    // F
    save_code_expect(70);
    save_values[3] = save_code_read_number();

    // Co
    save_code_expect(67);
    save_code_expect(111);
    save_values[4] = save_code_read_number();

    // P
    save_code_expect(80);
    save_values[5] = save_code_read_number();

    // Crit
    save_code_expect(67);
    save_code_expect(114);
    save_code_expect(105);
    save_code_expect(116);
    save_values[6] = save_code_read_number();

    // Cnt
    save_code_expect(67);
    save_code_expect(110);
    save_code_expect(116);
    save_values[7] = save_code_read_number();

    // CC
    save_code_expect(67);
    save_code_expect(67);
    save_values[8] = save_code_read_number();

    // Lif
    save_code_expect(76);
    save_code_expect(105);
    save_code_expect(102);
    save_values[9] = save_code_read_number();

    // Hi
    save_code_expect(72);
    save_code_expect(105);
    save_values[10] = save_code_read_number();

    // CU
    save_code_expect(67);
    save_code_expect(85);
    save_values[11] = save_code_read_number();

    // WU
    save_code_expect(87);
    save_code_expect(85);
    save_values[12] = save_code_read_number();

    // FU
    save_code_expect(70);
    save_code_expect(85);
    save_values[13] = save_code_read_number();

    // CoU
    save_code_expect(67);
    save_code_expect(111);
    save_code_expect(85);
    save_values[14] = save_code_read_number();

    // PU is the final field, so no trailing dash is allowed.
    save_code_expect(80);
    save_code_expect(85);
    let production_flag = save_code_read_number();

    if save_parse_pos != save_input_length {
        save_parse_ok = false;
    }

    if save_parse_ok {
        // Put PU into the spare final slot after parsing all required fields.
        if production_flag < 0 || production_flag > 1 {
            save_parse_ok = false;
        } else {
            // save_values has 15 fields. PU is carried by the temporary parse value.
            save_parse_value = production_flag;
        }
    }

    if save_parse_ok {
        if save_values[0] < 0 || save_values[0] > MAX_INT { save_parse_ok = false; }
        if save_values[1] < 0 || save_values[1] > MAX_GENERATORS { save_parse_ok = false; }
        if save_values[2] < 0 || save_values[2] > MAX_GENERATORS { save_parse_ok = false; }
        if save_values[3] < 0 || save_values[3] > MAX_GENERATORS { save_parse_ok = false; }
        if save_values[4] < 0 || save_values[4] > MAX_GENERATORS { save_parse_ok = false; }
        if save_values[5] <= 0 { save_parse_ok = false; }
        if save_values[6] < 0 || save_values[6] > 1 { save_parse_ok = false; }
        if save_values[7] < 0 || save_values[7] > MAX_INT { save_parse_ok = false; }
        if save_values[8] < 0 || save_values[8] > MAX_INT { save_parse_ok = false; }
        if save_values[9] < 0 || save_values[9] > MAX_INT { save_parse_ok = false; }
        if save_values[10] < 0 || save_values[10] > MAX_INT { save_parse_ok = false; }
        if save_values[11] < 0 || save_values[11] > MAX_GENERATORS { save_parse_ok = false; }
        if save_values[12] < 0 || save_values[12] > MAX_GENERATORS { save_parse_ok = false; }
        if save_values[13] < 0 || save_values[13] > MAX_GENERATORS { save_parse_ok = false; }
        if save_values[14] < 0 || save_values[14] > MAX_GENERATORS { save_parse_ok = false; }
    }
}

fn save_code_apply() {
    save_code_parse();

    if !save_parse_ok {
        save_status = 1;
        save_status_timer = millis() + 2500;
        return;
    }

    coins = save_values[0];
    cursors = save_values[1];
    workers = save_values[2];
    factories = save_values[3];
    cores = save_values[4];
    click_power = save_values[5];
    upgrade_critical = save_values[6] == 1;
    clicks = save_values[7];
    critical_clicks = save_values[8];
    lifetime_coins = save_values[9];
    highest_coins = save_values[10];
    cursor_click_upgrades = save_values[11];
    worker_click_upgrades = save_values[12];
    factory_click_upgrades = save_values[13];
    core_click_upgrades = save_values[14];
    upgrade_production = save_parse_value == 1;

    // The click upgrade itself is represented by click power. There is no
    // separate boolean needed once its +4 has been included in the save.
    upgrade_click = click_power >= 5;

    if upgrade_critical {
        click_multiplier = 2;
    } else {
        click_multiplier = 1;
    }

    combo = 0;
    combo_timer = 0;
    update_generator_costs();

    save_status = 2;
    save_status_timer = millis() + 1800;
    screen_mode = MODE_GAME;
}

fn save_code_clear() {
    if screen_mode == MODE_LOAD {
        load_field_length = 0;
        load_wizard_status = 0;
        return;
    }

    save_input_length = 0;
    save_status = 0;
    save_status_timer = 0;
}

fn save_code_backspace() {
    if screen_mode == MODE_LOAD {
        if load_field_length > 0 {
            load_field_length = load_field_length - 1;
        }
        load_wizard_status = 0;
        return;
    }

    if save_input_length > 0 {
        save_input_length = save_input_length - 1;
    }

    save_status = 0;
}

fn save_code_char(value: int) {
    if screen_mode == MODE_LOAD {
        load_wizard_add_digit(value);
        return;
    }

    if save_input_length < 255 {
        save_input[save_input_length] = value;
        save_input_length = save_input_length + 1;
        save_status = 0;
    }
}

fn save_code_draw_char(value: int, x: int, y: int, color: int) {
    draw_char_code(value, x, y, color);
}

fn save_code_draw_input() {
    let x = 12;
    let y = 48;
    let column = 6;
    let row_limit = 50;
    let i = 0;

    fill_rect(8, 34, 384, 134, BLACK);
    fill_rect(8, 34, 384, 2, AURORA);
    fill_rect(8, 166, 384, 2, DARK_GRAY);

    while i < save_input_length {
        let row = i / row_limit;
        let col = i % row_limit;
        save_code_draw_char(save_input[i], x + (col * column), y + (row * 20), WHITE);
        i = i + 1;
    }

    // A tiny cursor makes it obvious where more typing goes.
    if save_input_length < 256 {
        let cursor_row = save_input_length / row_limit;
        let cursor_col = save_input_length % row_limit;
        fill_rect(x + (cursor_col * column), y + (cursor_row * 20) + 12, 6, 2, AURORA);
    }
}

fn save_label_width(label: int) -> int {
    if label == 14 { return 6; }
    if label == 115 { return 18; }
    if label == 34 { return 6; }
    if label == 17 { return 6; }
    if label == 116 { return 12; }
    if label == 27 { return 6; }
    if label == 117 { return 24; }
    if label == 118 { return 18; }
    if label == 119 { return 12; }
    if label == 120 { return 18; }
    if label == 121 { return 12; }
    if label == 122 { return 12; }
    if label == 123 { return 12; }
    if label == 124 { return 12; }
    if label == 125 { return 18; }
    if label == 126 { return 12; }
    return 6;
}

fn draw_save_code_field(label: int, value: int, x: int, y: int) -> int {
    draw_text_id(label, x, y, AURORA);
    x = x + save_label_width(label) + 2;
    draw_int(value, x, y, WHITE);
    return x + (save_code_digit_count(value) * 6);
}

fn draw_save_code_line_one(y: int) {
    let x = 14;
    x = draw_save_code_field(14, coins, x, y);
    draw_text_id(1, x, y, GRAY); x = x + 6;
    x = draw_save_code_field(115, cursors, x, y);
    draw_text_id(1, x, y, GRAY); x = x + 6;
    x = draw_save_code_field(34, workers, x, y);
    draw_text_id(1, x, y, GRAY); x = x + 6;
    x = draw_save_code_field(17, factories, x, y);
    draw_text_id(1, x, y, GRAY); x = x + 6;
    draw_save_code_field(116, cores, x, y);
}

fn draw_save_code_line_two(y: int) {
    let x = 14;
    x = draw_save_code_field(27, click_power, x, y);
    draw_text_id(1, x, y, GRAY); x = x + 6;
    if upgrade_critical { x = draw_save_code_field(117, 1, x, y); }
    else { x = draw_save_code_field(117, 0, x, y); }
    draw_text_id(1, x, y, GRAY); x = x + 6;
    x = draw_save_code_field(118, clicks, x, y);
    draw_text_id(1, x, y, GRAY); x = x + 6;
    draw_save_code_field(119, critical_clicks, x, y);
}

fn draw_save_code_line_three(y: int) {
    let x = 14;
    x = draw_save_code_field(120, lifetime_coins, x, y);
    draw_text_id(1, x, y, GRAY); x = x + 6;
    x = draw_save_code_field(121, highest_coins, x, y);
    draw_text_id(1, x, y, GRAY); x = x + 6;
    x = draw_save_code_field(122, cursor_click_upgrades, x, y);
    draw_text_id(1, x, y, GRAY); x = x + 6;
    draw_save_code_field(123, worker_click_upgrades, x, y);
}

fn draw_save_code_line_four(y: int) {
    let x = 14;
    x = draw_save_code_field(124, factory_click_upgrades, x, y);
    draw_text_id(1, x, y, GRAY); x = x + 6;
    x = draw_save_code_field(125, core_click_upgrades, x, y);
    draw_text_id(1, x, y, GRAY); x = x + 6;
    if upgrade_production { draw_save_code_field(126, 1, x, y); }
    else { draw_save_code_field(126, 0, x, y); }
}

// -----------------------------------------------------------------------------
// okay so this is the part where the rectangles become a whole little universe
// -----------------------------------------------------------------------------
fn draw_header(text_value: int) {
    fill_rect(0, 0, 400, 26, DARK_GRAY);
    fill_rect(0, 24, 400, 2, AURORA);
    draw_text_id(text_value, 12, 7, WHITE);
}

fn draw_header_small(text_value: int) {
    fill_rect(0, 0, 320, 26, DARK_GRAY);
    fill_rect(0, 24, 320, 2, AURORA);
    draw_text_id(text_value, 12, 7, WHITE);
}

fn draw_card(x: int, y: int, w: int, h: int) {
    fill_rect(x, y, w, h, DARK_GRAY);
    fill_rect(x, y, w, 2, AURORA);
    fill_rect(x, y + h - 2, w, 2, BLACK);
}

fn draw_button(x: int, y: int, w: int, h: int, label: int) {
    fill_rect(x, y, w, h, DARK_GRAY);
    fill_rect(x, y, w, 2, GRAY);
    fill_rect(x, y + h - 2, w, 2, BLACK);
    draw_text_id(label, x + 6, y + (h / 2) - 4, WHITE);
}

fn draw_selected_button(x: int, y: int, w: int, h: int, label: int) {
    fill_rect(x, y, w, h, AURORA);
    fill_rect(x + 2, y + 2, w - 4, h - 4, DARK_GRAY);
    draw_text_id(label, x + 6, y + (h / 2) - 4, WHITE);
}

fn draw_coin_bar() {
    fill_rect(8, 30, 384, 48, DARK_GRAY);
    draw_text_id(38, 16, 38, GRAY);
    draw_int(coins, 16, 54, YELLOW);
    draw_text_id(39, 300, 38, GRAY);
    draw_int(get_production(), 300, 54, GREEN);
}

fn draw_click_meter() {
    let meter = combo;
    if meter > 20 {
        meter = 20;
    }

    fill_rect(8, 190, 384, 10, DARK_GRAY);
    if meter > 0 {
        fill_rect(8, 190, meter * 19, 10, AURORA);
    }
}

fn draw_game() {
    // top screen: behold, the sacred button. press it. make numbers happen.
    screen(0);
    clear(BLACK);
    draw_header(107);
    draw_coin_bar();

    draw_text_id(40, 16, 88, GRAY);
    draw_int(click_power, 16, 104, WHITE);
    draw_text_id(41, 310, 88, GRAY);
    draw_int(combo, 310, 104, AURORA);

    fill_rect(72, 124, 256, 58, AURORA);
    fill_rect(76, 128, 248, 50, DARK_GRAY);
    draw_text_id(42, 178, 141, WHITE);
    draw_text_id(43, 160, 158, GRAY);

    draw_click_meter();
    if combo_timer > millis() {
        draw_text_id(44, 126, 212, GREEN);
    } else {
        draw_text_id(45, 150, 212, GRAY);
    }

    // bottom screen: tiny dashboard, huge dreams, very little real estate.
    screen(1);
    clear(BLACK);
    draw_header_small(127);

    draw_card(8, 34, 148, 58);
    draw_text_id(46, 16, 42, GRAY);
    draw_int(cursors, 16, 60, WHITE);
    draw_text_id(47, 78, 60, GRAY);
    draw_int(cursors, 16, 78, GREEN);
    draw_text_id(48, 70, 78, GRAY);

    draw_card(164, 34, 148, 58);
    draw_text_id(49, 172, 42, GRAY);
    draw_int(workers, 172, 60, WHITE);
    draw_text_id(47, 234, 60, GRAY);
    draw_int(workers * 8, 172, 78, GREEN);
    draw_text_id(48, 234, 78, GRAY);

    draw_card(8, 98, 148, 58);
    draw_text_id(50, 16, 106, GRAY);
    draw_int(factories, 16, 124, WHITE);
    draw_text_id(47, 78, 124, GRAY);
    draw_int(factories * 60, 16, 142, GREEN);
    draw_text_id(48, 78, 142, GRAY);

    draw_card(164, 98, 148, 58);
    draw_text_id(51, 172, 106, GRAY);
    draw_int(cores, 172, 124, WHITE);
    draw_text_id(47, 234, 124, GRAY);
    draw_int(cores * 500, 172, 142, GREEN);
    draw_text_id(48, 234, 142, GRAY);

    if message_timer > millis() {
        if message_code == 1 {
            draw_text_id(52, 16, 164, GREEN);
        } else if message_code == 2 {
            draw_text_id(53, 16, 164, GREEN);
        } else if message_code == 3 {
            draw_text_id(54, 16, 164, GREEN);
        } else if message_code == 6 {
            draw_text_id(55, 16, 164, RED);
        } else if message_code == 7 {
            draw_text_id(56, 16, 164, GREEN);
        } else if message_code == 8 {
            draw_text_id(57, 16, 164, GREEN);
        }
    } else {
        draw_text_id(58, 16, 164, GRAY);
        draw_int(lifetime_coins, 78, 164, WHITE);
    }

    draw_button(8, 184, 304, 28, 128);
    draw_button(0, 214, 80, 26, 129);
    draw_button(80, 214, 80, 26, 130);
    draw_button(160, 214, 80, 26, 131);
    draw_button(240, 214, 80, 26, 132);
}

