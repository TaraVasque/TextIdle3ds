// -----------------------------------------------------------------------------
// button stuff. fingers go brrrr.
// -----------------------------------------------------------------------------
fn handle_game_keys(keys: int) {
    if (keys & KEY_A) != 0 {
        do_click();
    }

    if (keys & KEY_START) != 0 {
        screen_mode = MODE_MENU;
    }

    if (keys & KEY_LEFT) != 0 {
        screen_mode = MODE_SHOP;
    }

    if (keys & KEY_RIGHT) != 0 {
        screen_mode = MODE_STATS;
    }

    if (keys & KEY_DOWN) != 0 {
        screen_mode = MODE_SAVE;
    }
}

fn handle_shop_keys(keys: int) {
    if (keys & KEY_B) != 0 {
        screen_mode = MODE_GAME;
    }

    if (keys & KEY_UP) != 0 {
        if shop_cursor > 0 {
            shop_cursor = shop_cursor - 1;
        }
    }

    if (keys & KEY_DOWN) != 0 {
        if shop_cursor < 6 {
            shop_cursor = shop_cursor + 1;
        }
    }

    if (keys & KEY_A) != 0 {
        if shop_cursor == 0 {
            buy_cursor();
        } else if shop_cursor == 1 {
            buy_worker();
        } else if shop_cursor == 2 {
            buy_factory();
        } else if shop_cursor == 3 {
            buy_core();
        } else if shop_cursor == 4 {
            buy_click_upgrade();
        } else if shop_cursor == 5 {
            buy_production_upgrade();
        } else if shop_cursor == 6 {
            buy_critical_upgrade();
        }
    }
}

fn handle_stats_keys(keys: int) {
    if (keys & KEY_B) != 0 {
        screen_mode = MODE_GAME;
    }

    if (keys & KEY_A) != 0 {
        screen_mode = MODE_MENU;
    }
}

fn handle_save_keys(keys: int) {
    if (keys & KEY_B) != 0 {
        screen_mode = MODE_GAME;
    }
}

fn handle_load_keys(keys: int) {
    if (keys & KEY_B) != 0 {
        load_wizard_reset();
        screen_mode = MODE_MENU;
    }

    if (keys & KEY_A) != 0 {
        load_wizard_next();
    }
}

fn handle_menu_keys(keys: int) {
    if (keys & KEY_UP) != 0 {
        if menu_cursor > 0 {
            menu_cursor = menu_cursor - 1;
        }
    }

    if (keys & KEY_DOWN) != 0 {
        if menu_cursor < 6 {
            menu_cursor = menu_cursor + 1;
        }
    }

    if (keys & KEY_B) != 0 {
        screen_mode = MODE_GAME;
    }

    if (keys & KEY_A) != 0 {
        if menu_cursor == 0 {
            screen_mode = MODE_GAME;
        } else if menu_cursor == 1 {
            screen_mode = MODE_SHOP;
        } else if menu_cursor == 2 {
            screen_mode = MODE_STATS;
        } else if menu_cursor == 3 {
            screen_mode = MODE_SAVE;
        } else if menu_cursor == 4 {
            load_wizard_reset();
            screen_mode = MODE_LOAD;
        } else if menu_cursor == 5 {
            screen_mode = MODE_INFO;
        } else if menu_cursor == 6 {
            screen_mode = MODE_RESET;
        }
    }
}


fn handle_reset_keys(keys: int) {
    if (keys & KEY_B) != 0 {
        screen_mode = MODE_MENU;
    }

    if (keys & KEY_A) != 0 {
        reset_game();
        screen_mode = MODE_TITLE;
    }
}

// -----------------------------------------------------------------------------
// touch stuff. tiny touchscreen, huge responsibility.
// -----------------------------------------------------------------------------
fn handle_game_touch() {
    if touch_down() {
        if touch_in(8, 184, 304, 28) {
            do_click();
        } else if touch_in(0, 214, 80, 26) {
            screen_mode = MODE_SHOP;
        } else if touch_in(80, 214, 80, 26) {
            screen_mode = MODE_STATS;
        } else if touch_in(160, 214, 80, 26) {
            screen_mode = MODE_SAVE;
        } else if touch_in(240, 214, 80, 26) {
            screen_mode = MODE_MENU;
        }
    }
}

fn handle_shop_touch() {
    if touch_down() {
        if touch_in(8, 32, 304, 38) {
            shop_cursor = 0;
            buy_cursor();
        } else if touch_in(8, 74, 304, 38) {
            shop_cursor = 1;
            buy_worker();
        } else if touch_in(8, 116, 304, 38) {
            shop_cursor = 2;
            buy_factory();
        } else if touch_in(8, 158, 304, 38) {
            shop_cursor = 3;
            buy_core();
        } else if touch_in(8, 202, 98, 30) {
            buy_click_upgrade();
        } else if touch_in(111, 202, 98, 30) {
            buy_production_upgrade();
        } else if touch_in(214, 202, 98, 30) {
            buy_critical_upgrade();
        }
    }
}

fn handle_load_touch() {
    if !touch_down() {
        return;
    }

    // 1 2 3
    if touch_in(8, 82, 96, 26) { save_code_char(49); }
    else if touch_in(112, 82, 96, 26) { save_code_char(50); }
    else if touch_in(216, 82, 96, 26) { save_code_char(51); }
    // 4 5 6
    else if touch_in(8, 112, 96, 26) { save_code_char(52); }
    else if touch_in(112, 112, 96, 26) { save_code_char(53); }
    else if touch_in(216, 112, 96, 26) { save_code_char(54); }
    // 7 8 9
    else if touch_in(8, 142, 96, 26) { save_code_char(55); }
    else if touch_in(112, 142, 96, 26) { save_code_char(56); }
    else if touch_in(216, 142, 96, 26) { save_code_char(57); }
    // 0 / extra zero buttons
    else if touch_in(8, 172, 96, 26) { save_code_char(48); }
    else if touch_in(112, 172, 96, 26) { save_code_char(48); }
    else if touch_in(216, 172, 96, 26) { save_code_char(48); }
    // Backspace / clear / next
    else if touch_in(8, 202, 96, 26) { save_code_backspace(); }
    else if touch_in(112, 202, 96, 26) { save_code_clear(); }
    else if touch_in(216, 202, 96, 26) { load_wizard_next(); }
}

// -----------------------------------------------------------------------------
// save-code wizard helpers
// -----------------------------------------------------------------------------
fn load_wizard_reset() {
    load_step = 0;
    load_field_length = 0;
    load_wizard_status = 0;
    load_wizard_status_timer = 0;

    let i = 0;
    while i < 16 {
        load_values[i] = 0;
        i = i + 1;
    }
}

fn load_wizard_input_number() -> int {
    let value = 0;
    let i = 0;
    while i < load_field_length {
        value = (value * 10) + (load_field_input[i] - 48);
        i = i + 1;
    }
    return value;
}

fn load_wizard_field_valid(value: int) -> bool {
    if load_step == 0 { return value >= 0 && value <= MAX_INT; }
    if load_step >= 1 && load_step <= 4 { return value >= 0 && value <= MAX_GENERATORS; }
    if load_step == 5 { return value > 0 && value <= MAX_INT; }
    if load_step == 6 { return value == 0 || value == 1; }
    if load_step >= 7 && load_step <= 10 { return value >= 0 && value <= MAX_INT; }
    if load_step >= 11 && load_step <= 14 { return value >= 0 && value <= MAX_GENERATORS; }
    if load_step == 15 { return value == 0 || value == 1; }
    return false;
}

fn load_wizard_next() {
    if load_field_length <= 0 {
        load_wizard_status = 1;
        load_wizard_status_timer = millis() + 1200;
        return;
    }

    let value = load_wizard_input_number();
    if !load_wizard_field_valid(value) {
        load_wizard_status = 1;
        load_wizard_status_timer = millis() + 1600;
        return;
    }

    load_values[load_step] = value;

    if load_step < 15 {
        load_step = load_step + 1;
        load_field_length = 0;
        load_wizard_status = 0;
        return;
    }

    // All sections are present and valid. Apply them only now, so a mistake
    // halfway through the wizard can never partially overwrite the save.
    coins = load_values[0];
    cursors = load_values[1];
    workers = load_values[2];
    factories = load_values[3];
    cores = load_values[4];
    click_power = load_values[5];
    upgrade_critical = load_values[6] == 1;
    clicks = load_values[7];
    critical_clicks = load_values[8];
    lifetime_coins = load_values[9];
    highest_coins = load_values[10];
    cursor_click_upgrades = load_values[11];
    worker_click_upgrades = load_values[12];
    factory_click_upgrades = load_values[13];
    core_click_upgrades = load_values[14];
    upgrade_production = load_values[15] == 1;

    upgrade_click = click_power >= 5;
    if upgrade_critical {
        click_multiplier = 2;
    } else {
        click_multiplier = 1;
    }

    combo = 0;
    combo_timer = 0;
    message_timer = 0;
    message_code = 0;
    update_generator_costs();

    load_wizard_status = 2;
    load_wizard_status_timer = millis() + 1200;
    screen_mode = MODE_GAME;
}

fn load_wizard_add_digit(value: int) {
    if load_field_length < 11 {
        load_field_input[load_field_length] = value;
        load_field_length = load_field_length + 1;
        load_wizard_status = 0;
    }
}

fn draw_load_field_name(step: int, x: int, y: int, color: int) {
    if step == 0 { draw_text_id(161, x, y, color); return; }
    if step == 1 { draw_text_id(162, x, y, color); return; }
    if step == 2 { draw_text_id(163, x, y, color); return; }
    if step == 3 { draw_text_id(164, x, y, color); return; }
    if step == 4 { draw_text_id(165, x, y, color); return; }
    if step == 5 { draw_text_id(166, x, y, color); return; }
    if step == 6 { draw_text_id(167, x, y, color); return; }
    if step == 7 { draw_text_id(168, x, y, color); return; }
    if step == 8 { draw_text_id(169, x, y, color); return; }
    if step == 9 { draw_text_id(170, x, y, color); return; }
    if step == 10 { draw_text_id(171, x, y, color); return; }
    if step == 11 { draw_text_id(172, x, y, color); return; }
    if step == 12 { draw_text_id(173, x, y, color); return; }
    if step == 13 { draw_text_id(174, x, y, color); return; }
    if step == 14 { draw_text_id(175, x, y, color); return; }
    if step == 15 { draw_text_id(176, x, y, color); return; }
}

// -----------------------------------------------------------------------------
// the loop. it keeps the universe moving while we stare at numbers.
// -----------------------------------------------------------------------------
fn main() {
    init_font();
    reset_game();
    load_wizard_reset();
    buffered(true);

    screen_mode = MODE_TITLE;
    title_cursor = 0;
    menu_cursor = 0;
    last_second = millis();

    while running {
        let keys = keys_down();
        let now = millis();

        // every second the machines cough up some coins.
        if now >= last_second + 1000 {
            let production = get_production();

            if production > 0 {
                add_coins(production);
            }

            last_second = now;
        }

        if combo_timer > 0 {
            if now >= combo_timer {
                combo = 0;
                combo_timer = 0;
            }
        }

        if screen_mode == MODE_TITLE {
            // title screen. just idle. sitting there. looking suspiciously expensive.
            screen(0);
            clear(BLACK);
            fill_rect(54, 54, 292, 96, DARK_GRAY);
            fill_rect(58, 58, 284, 88, BLACK);
            draw_text_id(107, 164, 76, AURORA);
            draw_text_id(108, 112, 104, WHITE);
            draw_text_id(109, 88, 122, GRAY);
            draw_button(118, 164, 164, 36, 159);
            draw_text_id(110, 150, 214, GRAY);

            screen(1);
            clear(BLACK);
            draw_header(107);
            draw_text_id(111, 112, 48, AURORA);
            draw_text_id(112, 112, 76, WHITE);
            draw_text_id(113, 112, 98, WHITE);
            draw_text_id(114, 88, 136, GRAY);
            draw_button(80, 160, 160, 48, 160);

            if (keys & KEY_A) != 0 {
                screen_mode = MODE_GAME;
            }

            if (keys & KEY_START) != 0 {
                screen_mode = MODE_MENU;
            }

            if touch_down() {
                if touch_in(80, 160, 160, 48) {
                    screen_mode = MODE_GAME;
                }
            }
        } else if screen_mode == MODE_GAME {
            handle_game_keys(keys);
            handle_game_touch();
            draw_game();
        } else if screen_mode == MODE_SHOP {
            handle_shop_keys(keys);
            handle_shop_touch();
            draw_shop();
        } else if screen_mode == MODE_STATS {
            handle_stats_keys(keys);
            draw_stats();
        } else if screen_mode == MODE_SAVE {
            handle_save_keys(keys);
            draw_save();
        } else if screen_mode == MODE_LOAD {
            handle_load_keys(keys);
            handle_load_touch();
            draw_load();
        } else if screen_mode == MODE_RESET {
            handle_reset_keys(keys);
            draw_reset();
        } else if screen_mode == MODE_MENU {
            handle_menu_keys(keys);
            draw_menu();
        } else if screen_mode == MODE_INFO {
            if (keys & KEY_B) != 0 {
                screen_mode = MODE_MENU;
            }
            if (keys & KEY_A) != 0 {
                screen_mode = MODE_MENU;
            }
            draw_info();
        }

        present();
    }
}
