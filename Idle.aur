fn glyph_index(c: int) -> int {
    if c >= 97 && c <= 122 { c = c - 32; }
    if c == 65 { return 0; }
    if c == 66 { return 1; }
    if c == 67 { return 2; }
    if c == 68 { return 3; }
    if c == 69 { return 4; }
    if c == 70 { return 5; }
    if c == 71 { return 6; }
    if c == 72 { return 7; }
    if c == 73 { return 8; }
    if c == 74 { return 9; }
    if c == 75 { return 10; }
    if c == 76 { return 11; }
    if c == 77 { return 12; }
    if c == 78 { return 13; }
    if c == 79 { return 14; }
    if c == 80 { return 15; }
    if c == 81 { return 16; }
    if c == 82 { return 17; }
    if c == 83 { return 18; }
    if c == 84 { return 19; }
    if c == 85 { return 20; }
    if c == 86 { return 21; }
    if c == 87 { return 22; }
    if c == 88 { return 23; }
    if c == 89 { return 24; }
    if c == 90 { return 25; }
    if c == 48 { return 26; }
    if c == 49 { return 27; }
    if c == 50 { return 28; }
    if c == 51 { return 29; }
    if c == 52 { return 30; }
    if c == 53 { return 31; }
    if c == 54 { return 32; }
    if c == 55 { return 33; }
    if c == 56 { return 34; }
    if c == 57 { return 35; }
    if c == 32 { return 36; }
    if c == 45 { return 37; }
    if c == 43 { return 38; }
    if c == 47 { return 39; }
    if c == 46 { return 40; }
    if c == 61 { return 41; }
    if c == 58 { return 42; }
    if c == 95 { return 43; }
    if c == 44 { return 44; }
    return 0;
}

fn draw_char_code(c: int, x: int, y: int, color: int) {
    if c >= 97 && c <= 122 { c = c - 32; }
    let gi = glyph_index(c);
    let row = 0;
    while row < 7 {
        let mask = font_data[(gi * 7) + row];
        let col = 0;
        while col < 5 {
            if (mask & (1 << (4 - col))) != 0 {
                fill_rect(x + col, y + row, 1, 1, color);
            }
            col = col + 1;
        }
        row = row + 1;
    }
}

fn draw_int(value: int, x: int, y: int, color: int) {
    let work = value;
    if work < 0 {
        draw_char_code(45, x, y, color);
        x = x + 6;
        work = 0 - work;
    }
    if work == 0 {
        draw_char_code(48, x, y, color);
        return;
    }
    let divisor = 1;
    while (work / divisor) >= 10 { divisor = divisor * 10; }
    while divisor > 0 {
        let digit = (work / divisor) % 10;
        draw_char_code(48 + digit, x, y, color);
        x = x + 6;
        divisor = divisor / 10;
    }
}

fn draw_text_id(id: int, x: int, y: int, color: int) {
    if id == 1 {
        draw_char_code(45, x + 0, y, color);
        return;
    }
    if id == 2 {
        draw_char_code(48, x + 0, y, color);
        return;
