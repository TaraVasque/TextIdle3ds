        draw_text_id(61, 136, y + 6, AURORA);
        draw_int(upgrade_amount, 148, y + 6, AURORA);
        draw_text_id(42, 136, y + 22, GRAY);
        draw_int(upgrade_count, 218, y + 6, WHITE);
        draw_int(cost, 218, y + 22, YELLOW);
    }
}

