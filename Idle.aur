fn draw_load() {
    screen(0);
    clear(BLACK);
    draw_header(146);

    // The top screen is now a live checklist. Every completed section stays
    // visible while the player works through the save data one field at a time.
    let i = 0;
    while i < 16 {
        let col = 0;
        let row = i;
        if i >= 8 {
            col = 1;
            row = i - 8;
        }

        let x = 8 + (col * 196);
        let y = 34 + (row * 22);
        if i == load_step {
            fill_rect(x, y - 2, 190, 20, DARK_GRAY);
            fill_rect(x, y - 2, 3, 20, AURORA);
        }

        draw_load_field_name(i, x + 7, y + 2, GRAY);

        if i < load_step {
            draw_int(load_values[i], x + 112, y + 2, GREEN);
        } else if i == load_step {
            if load_field_length > 0 {
                draw_int(load_wizard_input_number(), x + 112, y + 2, WHITE);
            } else {
                draw_char_code(63, x + 112, y + 2, GRAY);
            }
        } else {
            draw_char_code(63, x + 112, y + 2, DARK_GRAY);
        }

        i = i + 1;
    }

    fill_rect(8, 212, 384, 22, DARK_GRAY);
    draw_text_id(179, 16, 219, AURORA);
    draw_int(load_step + 1, 50, 219, WHITE);
    draw_char_code(47, 62, 219, GRAY);
    draw_char_code(49, 68, 219, GRAY);
    draw_char_code(54, 74, 219, GRAY);
    draw_text_id(178, 94, 219, GRAY);

    screen(1);
    clear(BLACK);
    draw_header_small(147);

    draw_card(8, 34, 304, 42);
    draw_load_field_name(load_step, 16, 42, AURORA);
    if load_field_length > 0 {
        draw_int(load_wizard_input_number(), 16, 58, WHITE);
    } else {
        draw_char_code(63, 16, 58, GRAY);
    }

    // Numeric keypad. The save wizard only asks for a value, so there is no
    // reason to make the player hunt through a full QWERTY keyboard anymore.
    draw_button(8,   82, 96, 26, 3);
    draw_button(112, 82, 96, 26, 4);
    draw_button(216, 82, 96, 26, 5);
    draw_button(8,   112, 96, 26, 6);
    draw_button(112, 112, 96, 26, 7);
    draw_button(216, 112, 96, 26, 8);
    draw_button(8,   142, 96, 26, 9);
    draw_button(112, 142, 96, 26, 10);
    draw_button(216, 142, 96, 26, 11);
    draw_button(8,   172, 96, 26, 2);
    draw_button(112, 172, 96, 26, 148);
    draw_button(216, 172, 96, 26, 149);

    draw_button(8, 202, 96, 26, 148);
    draw_button(112, 202, 96, 26, 149);
    if load_step < 15 {
        draw_button(216, 202, 96, 26, 177);
    } else {
        draw_selected_button(216, 202, 96, 26, 150);
    }

    if load_wizard_status_timer > millis() {
        if load_wizard_status == 1 {
            draw_text_id(181, 118, 220, RED);
        } else if load_wizard_status == 2 {
            draw_text_id(180, 132, 220, GREEN);
        }
    }
}

